{
  "ai": {
    "signal": {
      "sample_interval_ms": 20,
      "sample_count": 200,
      "max_value": 4095
    },
    "paths": {
      "training_checkpoint_dir": "ai/checkpoints",
      "runtime_checkpoint_dir": "backend/app/ai/checkpoints",
      "checkpoint_name": "best.pt"
    },
    "model": {
      "dropout": 0.3,
      "conv_blocks": [
        {
          "in_channels": 1,
          "out_channels": 32,
          "kernel_size": 7,
          "padding": 3,
          "pool_size": 2
        },
        {
          "in_channels": 32,
          "out_channels": 64,
          "kernel_size": 5,
          "padding": 2,
          "pool_size": 2
        },
        {
          "in_channels": 64,
          "out_channels": 128,
          "kernel_size": 3,
          "padding": 1
        }
      ]
    },
    "inference": {
      "threshold": 0.5
    }
  }
}
